{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Capability for the main window",
  "identifier": "default",
  "permissions": [
    "core:default",
    "opener:default",
    {
      "allow": [
        {
          "path": "$APPCONFIG/**"
        }
      ],
      "identifier": "opener:allow-open-path"
    },
    "pytauri:default",
    "core:app:allow-default-window-icon"
  ],
  "windows": [
    "main"
  ]
}
